# ==========================================================
#  Bot-Link-Mtasa - environment configuration
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env file to GitHub.
# ==========================================================

# ---------- Discord bot ----------
# Discord Developer Portal -> Your App -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> Your App -> General Information -> Application ID
CLIENT_ID=
# Your Discord server (guild) ID (enable Developer Mode, right click server -> Copy Server ID)
GUILD_ID=

# ---------- MySQL (the SAME database your MTA:SA server uses) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------- MTA:SA game server ----------
# Public IP/host of the MTA server
MTA_SERVER_IP=127.0.0.1
# Game port (the one players connect to, default MTA port is 22003)
MTA_GAME_PORT=22003
# Admin account of the MTA server (must have ACL access to the "call" function over HTTP)
MTA_ADMIN_USER=
MTA_ADMIN_PASSWORD=
# MTA HTTP port(s) used for remote function calls. The bot tests them in order
# and uses the first reachable one. Comma separated.
MTA_HTTP_PORTS=22005

# ---------- Discord webhooks (log channels) - all optional ----------
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
WEBHOOK_MONEY_LOG=
WEBHOOK_ACTIVATE_LOG=
WEBHOOK_BAN_LOG=
WEBHOOK_VEHICLES_LOG=
WEBHOOK_RESTART_LOG=
WEBHOOK_PASSWORD_LOG=
WEBHOOK_BLACKLIST=
WEBHOOK_TICKETS_ONLY=
WEBHOOK_BAN_UNBAN=
WEBHOOK_CHANGE_ID=
WEBHOOK_WITHDRAW=
WEBHOOK_GROCERY=
WEBHOOK_BROADCAST=
WEBHOOK_SKIN_CHANGE=
WEBHOOK_BOT_CHAT=
